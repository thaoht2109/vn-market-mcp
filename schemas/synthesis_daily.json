{
  "type": "object",
  "additionalProperties": false,
  "required": ["thesis_summary", "supporting_points", "contradictions", "scenarios", "invalidation_rules", "label_recommendation"],
  "properties": {
    "thesis_summary": {"type": "string", "description": "Tóm tắt luận điểm, không chứa chữ số — số liệu chỉ qua placeholder {{field}}"},
    "supporting_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "evidence_ref"],
        "properties": {
          "text": {"type": "string"},
          "evidence_ref": {"type": "string", "description": "Đường dẫn trường dữ liệu trong snapshot, vd. technical.rsi14"}
        }
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "evidence_ref"],
        "properties": {
          "text": {"type": "string"},
          "evidence_ref": {"type": "string"}
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "invalidation_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition", "evidence_ref"],
        "properties": {
          "condition": {"type": "string", "description": "Điều kiện đo được bằng code, vd. 'roe dưới ngưỡng 4 quý liên tiếp'"},
          "evidence_ref": {"type": "string"}
        }
      }
    },
    "label_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["downgrade_to"],
      "properties": {
        "downgrade_to": {
          "type": ["string", "null"],
          "enum": ["watch", "reduce_exit", "stay_out", null],
          "description": "LLM chỉ được đề nghị hạ nhãn (spec §5.6/§5.7.3), null nếu không đề nghị hạ"
        },
        "reason": {"type": "string"}
      }
    }
  }
}
