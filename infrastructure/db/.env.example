# Postgres stack — copy to infrastructure/db/.env (never committed) and edit per machine.
# Every value has a working default in docker-compose.yml.

# Fixes the volume (<name>_pgdata) and network (<name>_default) names. The Hermes gateway joins
# <name>_default as an external network, so change both sides together. Changing it on a machine
# that has data starts an EMPTY database.
COMPOSE_PROJECT_NAME=vn-market-mcp
RESTART_POLICY=unless-stopped
POSTGRES_IMAGE=postgres:16
POSTGRES_DB=vnmcp
POSTGRES_ADMIN_USER=vnmcp_admin
POSTGRES_ADMIN_PASSWORD=changeme_local_only
# Port inside the compose network (Hermes' MCP servers use postgres:5433; 5432 is blocked by an iptables
# rule on the original host).
POSTGRES_PORT=5433
# Where clients reach it (root .env DATABASE_URL, the pipeline, the MCP service: <host>:<POSTGRES_PUBLISH_PORT>).
# Keep 127.0.0.1 unless another machine must connect.
POSTGRES_PUBLISH_BIND=127.0.0.1
POSTGRES_PUBLISH_PORT=55432
TZ=Asia/Ho_Chi_Minh
