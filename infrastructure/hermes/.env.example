# Copy to .env (git-ignored). Every value is optional; these are the defaults.
# Hermes image; the default is pinned by digest (v0.21.5). Change it to upgrade on purpose.
#HERMES_IMAGE=nousresearch/hermes-agent@sha256:d4da4a40cd7a28aba983775d9fd31d94cbf153eeb0cb9e844d6d0f612b7c24db
# Hermes' data directory on the host (profiles, memory, sessions): /opt/data in the containers
#HERMES_DATA_DIR=~/.hermes
# This repo's checkout, mounted read-only at /opt/vn-market-mcp (skills, MCP wrapper, setup_venv.sh)
#VN_MARKET_MCP_DIR=../..
#GATEWAY_PORT=8642
# Dashboard: host loopback only (127.0.0.1), reach it through an SSH/Tailscale tunnel
#DASHBOARD_PORT=9120
