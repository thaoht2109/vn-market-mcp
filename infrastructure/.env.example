# Docker stack config — copy to infrastructure/.env (never committed) and edit per machine.
# Every value has a working default in docker-compose.yml except the passwords marked REQUIRED.

# --- Compose project -------------------------------------------------------------------
# Fixes the volume (<name>_pgdata) and network (<name>_default) names. The Hermes gateway joins
# <name>_default as an external network, so change both sides together.
COMPOSE_PROJECT_NAME=vn-market-mcp
RESTART_POLICY=unless-stopped

# --- Images / build --------------------------------------------------------------------
POSTGRES_IMAGE=postgres:16
PYTHON_IMAGE=python:3.11-slim
# vnstock/vnai live on vnstock's own index, not public PyPI.
PIP_EXTRA_INDEX_URL=https://vnstocks.com/api/simple

# --- Postgres --------------------------------------------------------------------------
POSTGRES_DB=vnmcp
POSTGRES_ADMIN_USER=vnmcp_admin
POSTGRES_ADMIN_PASSWORD=changeme_local_only
# Service name + port inside the compose network (Hermes and the app containers use postgres:5433;
# 5432 is blocked by an iptables rule on the original host).
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
# Where the host reaches it (root .env DATABASE_URL etc. use localhost:<POSTGRES_PUBLISH_PORT>).
# Keep 127.0.0.1 unless another machine must connect.
POSTGRES_PUBLISH_BIND=127.0.0.1
POSTGRES_PUBLISH_PORT=55432
TZ=Asia/Ho_Chi_Minh

# Role passwords — REQUIRED. Must match the root .env (db/setup_roles.py sets them in Postgres).
PIPELINE_RW_PASSWORD=changeme
RETENTION_JOB_PASSWORD=changeme

# --- Worker ----------------------------------------------------------------------------
WORKER_REPLICAS=2
# Host dir for run_analysis snapshots, relative to this folder or absolute. Must be the same
# host dir the Hermes gateway sees as /opt/vn-market-mcp/snapshots.
SNAPSHOTS_DIR=../snapshots

# --- External services -----------------------------------------------------------------
VNSTOCK_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
